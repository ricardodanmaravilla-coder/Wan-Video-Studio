# App worker mode: http | gradio
WORKER_MODE=gradio
WORKER_URL=http://127.0.0.1:7860
WORKER_TOKEN=change-me

# Hugging Face ZeroGPU
HF_SPACE_T2V=tu_usuario/wan-video-studio-t2v
HF_SPACE_I2V=tu_usuario/wan-video-studio-i2v
HF_TOKEN=

# Local HTTP worker
MOCK_MODE=1

# Wan local real
WAN_REPO=./Wan2.2
WAN_CKPT=./Wan2.2-TI2V-5B
WAN_SIZE=1280*704

# ZeroGPU model defaults
WAN_MODEL_ID=yetter-ai/Wan2.2-TI2V-5B-Turbo-Diffusers
WAN_NUM_FRAMES=121
WAN_FPS=24
WAN_STEPS=4
WAN_SEED=43
